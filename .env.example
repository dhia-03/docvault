# Copy to .env and replace both values with local test passwords.
POSTGRES_PASSWORD=replace-me
SEED_PASSWORD=replace-me
# Key that signs session cookies, at least 32 characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-me
# Local port for the application.
APP_PORT=8000
